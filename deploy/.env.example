# ============================================================
# reader 部署配置模板
# 复制为 .env 后按需修改（.env 已 gitignore，不会提交）
#   cp .env.example .env
# 全部变量都有默认值，不填也能跑（默认单用户模式，端口 8080）
# ============================================================

# ---------- 容器 / 端口 ----------
# 宿主发布端口（容器内固定 8080）
READER_PORT=8080
# compose 项目名与容器名（多实例部署时改这里避免冲突）
COMPOSE_PROJECT_NAME=reader
READER_CONTAINER_NAME=reader
# 使用的镜像（自建镜像可改成 reader-hehecat:custom 等）
READER_IMAGE=ghcr.io/hehecat/reader:latest
# 宿主机数据目录（书架、书源、缓存 sqlite 都在这里）
READER_STORAGE_DIR=./storage
# 重启策略
READER_RESTART_POLICY=unless-stopped
TZ=Asia/Shanghai

# ---------- 用户与安全模式 ----------
# single = 单用户免登录；multi = 多用户需登录
READER_APP_MODE=single
# 是否开启登录鉴权（multi 应为 true）
READER_APP_SECURE=false
# 管理密码（管理员后台操作需要）
READER_APP_SECUREKEY=
# 注册邀请码（secure 模式下注册必填；留空 = 不需要邀请码）
READER_APP_INVITECODE=
# 最小密码长度
READER_APP_MINUSERPASSWORDLENGTH=8
# 用户数上限 / 单用户书籍上限
READER_APP_USERLIMIT=500000
READER_APP_USERBOOKLIMIT=500000
# token 有效期（天，<=0 永不过期）非管理员 token 默认 30 天
READER_TOKEN_TTL_DAYS=30

# ---------- 网络与抓取 ----------
# 图片/TTS/登录检测是否放行私网地址（自建部署可开）
SSRF_ALLOW_PRIVATE=false
# 书源抓取是否放行私网（局域网书源/本地书才需要开）
READER_ALLOW_PRIVATE_SOURCE=false
# 搜索抓取重试次数（死源排空速度；源站普遍慢时可下调）
READER_HTTP_RETRIES=1
# 是否优先走浏览器内核抓取（0=否，1=是；开了会慢很多，仅反爬站点需要）
READER_BROWSER_FIRST=0
# SQLite WAL 连接池上限
READER_DB_MAX_CONNECTIONS=24

# ---------- 搜索与换源性能 ----------
# 单源抓取端到端 deadline（秒；越小越快出结果，但慢源会被放弃）
# 4000+ 书源场景建议 12-20；书源精简后可调大到 60
READER_SEARCH_SOURCE_DEADLINE_SECS=12
# 全源换源并发数 —— 按服务器核数调：
#   2 核  → 32~48
#   4 核  → 64
#   8 核+ → 96~128
READER_SWITCH_SEARCH_CONCURRENCY=48
# 换源时单个书源的超时（秒）
READER_SWITCH_SEARCH_TIMEOUT=8
# 换源全量搜索总时间预算（秒）
READER_SWITCH_SEARCH_BUDGET_SECS=60
# 书源失效检测并发（HEAD 探测，很轻量）
READER_CHECK_SOURCES_CONCURRENCY=32

# ---------- 资源限制 ----------
# 容器内存上限（编译/大批量搜索需要；1g 在 2 核机上够用，3g 更稳）
READER_MEM_LIMIT=3g
# swap 倾向（0-100，越低越不爱用 swap）
READER_MEM_SWAPPINESS=30
# 单文件上传上限（MB）
READER_UPLOAD_MAX_MB=100
